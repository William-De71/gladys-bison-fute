{
  "name": "gladys-bison-fute",
  "version": "0.1.1",
  "private": true,
  "description": "External Gladys Assistant integration for Bison Futé: road events (closures, accidents, traffic jams, roadworks) around your home on the French national road network, and the green/orange/red/black traffic forecasts of your department, with scenes and dashboard widgets.",
  "homepage": "https://github.com/William-De71/gladys-bison-fute",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-bison-fute.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.15.0",
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "bison-fute",
    "road-traffic",
    "traffic",
    "datex-ii",
    "france",
    "home-automation"
  ]
}
